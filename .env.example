# Copy to .env and fill in. .env is never committed.
#
# ---------------------------------------------------------------------------
# Calendar feeds (ICS)
# ---------------------------------------------------------------------------
# Every calendar is defined here — the app scans the environment for
# CAL_<KEY>_URL and builds one feed per match, so adding another calendar is
# just three new lines below plus a restart. Nothing else references the URLs.
#
#   CAL_<KEY>_URL          the ICS URL          (required — defines the feed)
#   CAL_<KEY>_LABEL        legend label         (optional; defaults to <Key>)
#   CAL_<KEY>_COLOR        chip colour (hex)    (optional; auto-assigned if unset)
#   CAL_<KEY>_ORDER        display order (int)  (optional; defaults to 100)
#   CAL_<KEY>_ALERT_COLOR  hex (optional): if set, any event from this feed
#                          covering today raises a shiny alert pill in this colour
#                          on the photo panel (see the Alerts section below)
#   CAL_<KEY>_CLOSED_LABEL text (optional): if set, every holiday-category event
#                          from this feed reads "<label> – <title up to its
#                          first ':'>" on the hero's NEXT HOLIDAY line and the
#                          radar (grid chips keep the raw title)
#   CAL_<KEY>_DISMISSAL_LABEL text (optional): the same for early-dismissal
#                          events ("dismissal" category), on the hero
#                          lines and radar; label text already in the title
#                          is dropped ("End of Quarter/Early Dismissal: ..." ->
#                          "Early dismissal – End of Quarter")
#
# <KEY> is any short name (family, school, trash, soccer, ...); it is also the
# per-event source tag stored in the cache, so keep it stable once chosen.

# Family Google Calendar — read through the Google Calendar API with a service
# account, NOT its secret iCal URL (that endpoint is cached by Google for
# hours). Setup: docs/deployment.md "Google Calendar (service account)".
#   GCAL_CALENDAR_ID           the calendar id from Settings -> <calendar> ->
#                              Integrate calendar (never "primary"). Blank =
#                              the family feed is disabled.
#   GCAL_SERVICE_ACCOUNT_FILE  the service-account JSON key; relative paths are
#                              from the repo root. Keep it under data/
#                              (git-ignored), never in static/.
# The feed is stored under key "family", so the CAL_FAMILY_* display settings
# below still apply. CAL_FAMILY_URL is retired and ignored (a warning is logged
# if it is set). Check the setup with: python scripts/test_calendar.py
GCAL_CALENDAR_ID=
GCAL_SERVICE_ACCOUNT_FILE=data/gcal-sa.json
CAL_FAMILY_LABEL=Family
CAL_FAMILY_COLOR=#ffa94d
CAL_FAMILY_ORDER=10

# Cabarrus County Schools calendar.
CAL_SCHOOL_URL=https://www.cabarrus.k12.nc.us/sndreq/generateCalendarICS.php?calendar_id=121995
CAL_SCHOOL_LABEL=School
CAL_SCHOOL_COLOR=#74c0fc
CAL_SCHOOL_ORDER=20
# Hero / radar prefixes for school holidays ("School closed – Veterans Day")
# and early dismissals ("Early dismissal – End of Quarter").
CAL_SCHOOL_CLOSED_LABEL=School closed
CAL_SCHOOL_DISMISSAL_LABEL=Early dismissal

# Trash / recycling pickup (ReCollect).
CAL_TRASH_URL=https://api.recollect.net/api/places/B7318484-9123-11E9-A7CB-41E42D0D03FE/services/715/events.en-US.ics?client_id=FDAF5534-7E57-11F1-8419-91BF8324B35A
CAL_TRASH_LABEL=Trash
CAL_TRASH_COLOR=#51cf66
CAL_TRASH_ORDER=30

# ---------------------------------------------------------------------------
# Calendar refresh schedule
# ---------------------------------------------------------------------------
# Calendars refresh nightly at a local wall-clock time (default every day at
# 23:00). A restart always fetches immediately, so a feed you just added shows
# up without waiting for the next run. DAY is "*" for every day, or a name
# (mon..sun) / 0-6 (mon=0) to pin it to one day (e.g. "sat" for weekly);
# HOUR/MINUTE are 24-hour local time.
CALENDAR_REFRESH_DAY=*
CALENDAR_REFRESH_HOUR=23
CALENDAR_REFRESH_MINUTE=0
# How many days ahead the calendars are cached (default 90). The grid and
# agenda still list 30 days; the longer cache lets the per-child NEXT UP /
# NEXT HOLIDAY see a daycare closure weeks away.
EVENT_CACHE_DAYS=90

# ---------------------------------------------------------------------------
# Weather (NWS / api.weather.gov)
# ---------------------------------------------------------------------------
# Location the forecast is fetched for (default Harrisburg, NC).
WEATHER_LAT=35.3238
WEATHER_LON=-80.6581
# api.weather.gov asks for a contact address in the User-Agent.
NWS_USER_AGENT=(FamilyWallDashboard, acd@gmail.com)
# How often the server re-fetches weather, in seconds (default 1800 = 30 min).
WEATHER_REFRESH_SECONDS=1800
# Days shown in the outlook strip, not counting today (default 4).
FORECAST_DAYS=4

# ---------------------------------------------------------------------------
# Photos — Google Photos shared album sync
# ---------------------------------------------------------------------------
# Point this at a Google Photos album shared as "anyone with the link". The
# server scrapes that page (no Google login), downloads each image into photos/
# and the slideshow shows them. Leave blank to disable and just drop images
# into photos/ by hand.
#
# To get the link, in the Google Photos app/site: open the album -> Share ->
# "Create link" (or copy an existing link) -> paste it below. Make sure link
# sharing is on; a private album cannot be synced without a Google login.
PHOTOS_ALBUM_URL=
# How often the album is re-synced, in seconds (default 3600 = hourly).
PHOTO_SYNC_REFRESH_SECONDS=3600
# Keep at most this many album photos locally (0 = no cap).
PHOTO_SYNC_MAX=300
# Pixel box each photo is downloaded at (fit within, never cropped).
PHOTO_SYNC_WIDTH=1920
PHOTO_SYNC_HEIGHT=1080
# Slideshow pacing (browser side). Seconds each photo shows before crossfading,
# and how often the page re-reads the photo list for newly-synced files.
PHOTO_INTERVAL_SECONDS=10
PHOTO_LIST_REFRESH_SECONDS=1800

# ---------------------------------------------------------------------------
# Event colour categories
# ---------------------------------------------------------------------------
# An event whose TITLE matches a category's keywords is coloured by category on
# the month grid + agenda (instead of its calendar's colour), and its day cells
# are tinted so a multi-day span — a whole break week — reads as one block.
#
# Built-in categories and colours:
#   holiday  red     — holiday, no school, teacher/workday, break, closed,
#                      vacation, and named US holidays (Christmas, Memorial Day…)
#   dismissal gold   — early dismissal/release, half day, "Closes 12:00"
#                      (outranks quarter: "End of Quarter/Early Dismissal")
#   school   gold    — first/last day of school
#   quarter  purple  — end of quarter, end of grading period
#
# Tune any of them, or add your own:
#   EVENT_STYLE_<KEY>_KEYWORDS = extra, phrases   (APPENDED to the built-ins)
#   EVENT_STYLE_<KEY>_COLOR    = #rrggbb          (overrides the built-in)
#   EVENT_STYLE_<KEY>_ORDER    = <int>            (lower wins if >1 matches)
# A brand-new <KEY> needs at least _KEYWORDS and _COLOR to take effect.

# Cabarrus-specific "days off for kids" that aren't generic English — added to
# the red holiday category. (Remove if you point the school feed elsewhere.)
EVENT_STYLE_HOLIDAY_KEYWORDS=capped workday, uncapped workday
EVENT_STYLE_HOLIDAY_COLOR=#ff6b6b
# First/last day of school and early dismissal / release -> golden-orange.
EVENT_STYLE_SCHOOL_COLOR=#ffab00
EVENT_STYLE_DISMISSAL_COLOR=#ffab00
# End of quarter -> purple.
EVENT_STYLE_QUARTER_COLOR=#b197fc

# ---------------------------------------------------------------------------
# Persons (v2 wall)
# ---------------------------------------------------------------------------
# Each household member with a column on the wall. Discovered like the feeds:
# the app scans for PERSON_<KEY>_LABEL and builds one person per match.
#
#   PERSON_<KEY>_LABEL     display name               (required — defines them)
#   PERSON_<KEY>_COLOR     chip colour (hex)          (optional; auto if unset)
#   PERSON_<KEY>_ORDER     int, lower first           (the hero shows the first two)
#   PERSON_<KEY>_FEEDS     comma list of feed keys wholly theirs (e.g. school)
#   PERSON_<KEY>_KEYWORDS  comma list; an event whose title contains one as a
#                          whole word (case-insensitive) is theirs too
#
# A person tag set on the event itself (Google feed, Phase 4) wins over both.
PERSON_PRISHA_LABEL=Prisha
PERSON_PRISHA_COLOR=#19b2d8
PERSON_PRISHA_ORDER=1
PERSON_PRISHA_FEEDS=school
PERSON_PRISHA_KEYWORDS=prisha

PERSON_PRAPTI_LABEL=Prapti
PERSON_PRAPTI_COLOR=#bc39bd
PERSON_PRAPTI_ORDER=2
PERSON_PRAPTI_FEEDS=
PERSON_PRAPTI_KEYWORDS=prapti

# Feeds whose events take the person's colour on the grid when exactly one
# person matched (school / trash keep their feed colour regardless).
PERSON_COLOR_FEEDS=family
# The family line under the kids: events from these feeds that matched nobody.
FAMILY_FEEDS=family
# Event colour categories (see above) that count as the hero's NEXT HOLIDAY.
HERO_HOLIDAY_CATEGORIES=holiday

# "On the radar" footer: events in the next RADAR_DAYS whose title contains
# one of these (case-insensitive). Separate from the v1 HIGHLIGHT_* ticker.
RADAR_KEYWORDS=first day of school, early dismissal, no school, holiday, end of quarter, capped workday
RADAR_DAYS=30

# Events to hide from the wall entirely: any event whose title contains one of
# these (case-insensitive substring) is dropped by /api/events — grid, hero,
# radar, waste and the v1 ticker all skip it. The cache keeps everything, so
# changing this needs only a restart, no refetch. Blank = hide nothing.
EVENT_EXCLUDE_KEYWORDS=board of education, school bond, community forum, futures fair

# Importer: persons whose kind=closed imports are titled "Daycare closed – …"
# (so they land in the red holiday category on the wall).
IMPORT_DAYCARE_PERSONS=prapti

# Waste strip colour, from the first upcoming pickup (a TRASH_REMINDER_KEYWORDS
# event): recycle if its title contains one of these, else bulky, else
# regular. Recycling wins when a pickup has both (they share a day here).
WASTE_RECYCLE_KEYWORDS=recycling
WASTE_BULKY_KEYWORDS=bulky

# ---------------------------------------------------------------------------
# Upcoming highlights ticker
# ---------------------------------------------------------------------------
# The one-line strip between the agenda and weather. Any event in the next
# HIGHLIGHT_DAYS whose title contains one of these (case-insensitive) keywords
# is listed as "MonDay: Title". Leave HIGHLIGHT_KEYWORDS blank to hide it.
HIGHLIGHT_KEYWORDS=first day of school, early dismissal, no school, holiday, end of quarter, capped workday, recycling, yard waste
HIGHLIGHT_DAYS=7

# ---------------------------------------------------------------------------
# Alerts (Phase 3)
# ---------------------------------------------------------------------------
# Alerts show as a single shiny pill along the BOTTOM of the photo panel — they
# never push the dashboard layout. It is hidden most of the time, fades in for
# ALERT_SHOW_SECONDS once every ALERT_CYCLE_SECONDS, and while in view it rotates
# through the active alerts one at a time (each for ALERT_ROTATE_SECONDS). What
# can raise one, and its shiny colour:
#   - a school closure / early dismissal covering today (weekdays)  -> red
#   - a trash/recycling pickup today, or tomorrow after 5 pm        -> gold-orange
#   - a matching NWS weather alert for WEATHER_LAT/LON              -> red/gold
#   - any event from a calendar with CAL_<KEY>_ALERT_COLOR set      -> that colour

# How often the server re-polls NWS for active alerts (default 600 = 10 min).
ALERTS_REFRESH_SECONDS=600
# Reveal timing: seconds in view, the cycle it reappears on, and how long each
# alert shows before rotating to the next (default: 1 minute every 30, 7 s each).
ALERT_SHOW_SECONDS=60
ALERT_CYCLE_SECONDS=1800
ALERT_ROTATE_SECONDS=7

# NWS event names that always qualify (case-insensitive substring match).
ALERT_WEATHER_KEYWORDS=thunderstorm, lightning, heat advisory
# Safety net: any NWS alert at these severities qualifies too, so a Tornado or
# Flash Flood Warning is never dropped even if not in the keywords. Blank = off.
ALERT_SAFETY_SEVERITIES=Extreme,Severe
# A qualifying NWS alert is red at these severities (or if its name contains
# "warning"); everything else (advisories/watches, e.g. Heat Advisory) is gold.
ALERT_RED_SEVERITIES=Extreme,Severe

# Trash/recycling: event-title keywords, and the hour (24h) at which tomorrow's
# pickup starts nagging the evening before.
TRASH_REMINDER_KEYWORDS=trash, recycling, garbage, yard waste
TRASH_REMINDER_HOUR=17
# Which event colour-categories count as a school closure (reuses the category
# keywords above). Fires on a weekday the closure covers.
CLOSURE_ALERT_CATEGORIES=school, holiday, dismissal

# ---------------------------------------------------------------------------
# Frontend polling / networking
# ---------------------------------------------------------------------------
# How often the page re-reads /api/events and /api/weather (cached rows, cheap).
DATA_REFRESH_SECONDS=300
# Timeout for every outbound fetch, in seconds.
FETCH_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# The app writes its own rotating log (startup, fetch results, admin actions),
# viewable and downloadable on the /admin page. This is captured no matter how
# the app is launched (dev server or NSSM service), and is separate from NSSM's
# own stdout/stderr capture.
#
# Where the log files live. Blank = data/logs/ (git-ignored). Set an absolute
# path to send them elsewhere.
LOG_DIR=
# Root log level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
# The active file (dashboard.log) rolls at local midnight; this many past daily
# files are kept (older ones are pruned). They stay downloadable until pruned.
LOG_RETENTION_DAYS=14
